@startuml
hide circle
skinparam classAttributeIconSize 0

class ShoppingListApp {
  +start()
}

interface ListRepository {
  +getLists(): List<ShoppingList>
  +saveList(list: ShoppingList): void
  +deleteList(id: String): void
  +getItems(listId: String): List<Item>
  +saveItem(listId: String, item: Item): void
  +deleteItem(listId: String, itemId: String): void
}

class LocalStorageRepository implements ListRepository {
  -storage: KeyValueStore
}

class ShoppingList {
  +id: String
  +name: String
  +createdAt: Date
  +items: List<Item>
  +rename(newName: String): void
}

class Item {
  +id: String
  +name: String
  +quantity: int
  +category: String
  +checked: bool
  +toggleChecked(): void
}

class NavigationController {
  +goTo(page: Page): void
  +back(): void
}

abstract class Page {
  +name: String
  +render(): void
}

class HomePage extends Page
class ListsPage extends Page
class ItemsPage extends Page
class EditItemPage extends Page
class SettingsPage extends Page

class ShareService {
  +exportAsText(list: ShoppingList): String
  +share(list: ShoppingList): void
}

class SearchService {
  +searchItems(query: String, items: List<Item>): List<Item>
}

class SortFilterService {
  +sort(items: List<Item>, by: String): List<Item>
  +filter(items: List<Item>, criterion: String): List<Item>
}

ShoppingListApp --> NavigationController
ShoppingListApp --> ListRepository
ShoppingListApp --> ShareService
ShoppingListApp --> SearchService
ShoppingListApp --> SortFilterService

NavigationController --> Page
HomePage --> ListsPage
ListsPage --> ItemsPage
ItemsPage --> EditItemPage
ItemsPage --> SettingsPage

ListRepository <|.. LocalStorageRepository
ShoppingList "1" o-- "*" Item
@enduml
