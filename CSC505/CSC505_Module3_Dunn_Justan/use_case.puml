@startuml
left to right direction
actor "Shopper" as User
rectangle "Shopping List App" {
  usecase "Create New List" as UC_CreateList
  usecase "View Lists" as UC_ViewLists
  usecase "Rename/Delete List" as UC_ManageList
  usecase "Add Item" as UC_AddItem
  usecase "Edit/Remove Item" as UC_EditItem
  usecase "Check/Uncheck Item" as UC_CheckItem
  usecase "Sort/Filter Items" as UC_SortFilter
  usecase "Search Items" as UC_Search
  usecase "Export/Share List" as UC_Share
  usecase "Settings" as UC_Settings
  usecase "Local Persist" as UC_Persist
  usecase "Optional: Cloud Sync" as UC_Sync
  UC_AddItem --> UC_Persist : <<include>>
  UC_EditItem --> UC_Persist : <<include>>
  UC_ManageList --> UC_Persist : <<include>>
  UC_Share ..> UC_Persist : <<extend>>
}
User --> UC_CreateList
User --> UC_ViewLists
User --> UC_ManageList
User --> UC_AddItem
User --> UC_EditItem
User --> UC_CheckItem
User --> UC_SortFilter
User --> UC_Search
User --> UC_Share
User --> UC_Settings
@enduml